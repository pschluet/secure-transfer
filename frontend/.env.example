# Populated from CDK stack outputs at build time by the GitHub Actions workflow.
VITE_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# In production the SPA and API share an origin via CloudFront (/api/*), so
# this can stay unset. Only needed for local dev against a deployed API.
# VITE_API_URL=https://transfer.pauldev.io/api

# Vite dev server proxies /api/* here (defaults to http://localhost:3000).
# Point it at your deployed HttpApi to run the frontend locally against real data.
# VITE_DEV_API_PROXY_TARGET=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
